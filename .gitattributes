# =====================================================================
# Archive export: omit dev metadata from `git archive` tarballs.
# Shipped commented out: in the template repository these paths ARE the
# product, and forge source downloads (for example GitHub's Download ZIP)
# honor export-ignore. repo-init offers to uncomment every
# `# <path> export-ignore` line in a consumer repository.
# =====================================================================
# .gitattributes  export-ignore
# .gitignore      export-ignore
# .gitmodules     export-ignore
# .gitmessage     export-ignore
# .github/        export-ignore
# .gitlab/        export-ignore

# =====================================================================
# AI agent tools. Canonical content lives in AGENTS.md and .agents/;
# tool directories hold only adapters (see AGENTS.md, Layout).
# =====================================================================
# Skills adapter links (`.<tool>/skills -> ../.agents/skills`): Windows
# links are typed and git records no type, so declare them as directory
# links (Git for Windows honors symlink=dir; other git builds ignore the
# attribute harmlessly). No effect on the real .agents/skills directory.
skills          symlink=dir

# Archive export: the canonical AGENTS.md and .agents/, plus the root
# instruction files and project-level directories of mainstream AI agent
# tools. Listing absent paths is harmless. Commented out in the template
# like the section above. Add a tool not listed here when adding its
# adapter; once enabled, repo-init reports adapter links whose top
# directory is missing. Keep the trailing slash on directories: `dir/`
# patterns match directory paths only. Cline reads workspace rules from
# either a `.clinerules/` or a `.cline/rules/` directory, so both top
# directories are listed. The root instruction file names carry no leading slash, so
# they also match nested AGENTS.md, CLAUDE.md, and GEMINI.md files;
# excluding those nested instruction files is deliberate.
# .agents/        export-ignore
# .amazonq/       export-ignore
# .claude/        export-ignore
# .cline/         export-ignore
# .clinerules/    export-ignore
# .codex/         export-ignore
# .continue/      export-ignore
# .cursor/        export-ignore
# .devin/         export-ignore
# .gemini/        export-ignore
# .junie/         export-ignore
# .kiro/          export-ignore
# .opencode/      export-ignore
# .roo/           export-ignore
# .trae/          export-ignore
# .windsurf/      export-ignore
