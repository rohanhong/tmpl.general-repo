# =====================================================================
# Windows-only scripts: retain CRLF on Windows checkouts
# =====================================================================
*.bat           text eol=crlf
*.cmd           text eol=crlf
*.ps1           text eol=crlf
*.psm1          text eol=crlf
*.psd1          text eol=crlf
*.vbs           text eol=crlf
*.reg           text eol=crlf

# =====================================================================
# Raw bytes: disable EOL normalization but keep diff for review
# (patches contain CRLF lines that must survive; PEM certs and keys
#  carry meaningful textual headers, so they stay diffable when a
#  project deliberately tracks them; .gitignore ignores *.pem and *.key
#  by default).
# =====================================================================
*.patch         -text
*.diff          -text
*.pem           -text
*.crt           -text
*.cer           -text
*.key           -text
*.csr           -text

